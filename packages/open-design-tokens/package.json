{
  "name": "open-design-tokens",
  "version": "0.1.1",
  "description": "TypeScript toolkit for validating and linting DTCG design tokens.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bezel-labs/open-design-tokens.git",
    "directory": "packages/open-design-tokens"
  },
  "bugs": {
    "url": "https://github.com/bezel-labs/open-design-tokens/issues"
  },
  "homepage": "https://opendesigntokens.com",
  "keywords": [
    "dtcg",
    "design-tokens",
    "validator",
    "validation",
    "linter",
    "typescript",
    "w3c",
    "design-system"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./validator": {
      "types": "./dist/validator.d.ts",
      "import": "./dist/validator.js",
      "require": "./dist/validator.cjs"
    },
    "./linter": {
      "types": "./dist/linter.d.ts",
      "import": "./dist/linter.js",
      "require": "./dist/linter.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dtcg-lint": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:types": "vitest run --typecheck.only"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
