{
  "name": "open-design-tokens-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript toolkit for validating and linting DTCG design tokens.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bezel-labs/open-design-tokens.git"
  },
  "bugs": {
    "url": "https://github.com/bezel-labs/open-design-tokens/issues"
  },
  "homepage": "https://github.com/bezel-labs/open-design-tokens#readme",
  "keywords": [
    "dtcg",
    "design-tokens",
    "validator",
    "validation",
    "linter",
    "typescript",
    "w3c",
    "design-system"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "check": "biome check .",
    "format": "biome format --write .",
    "ci": "biome ci .",
    "spec-coverage": "node scripts/spec-coverage.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  },
  "packageManager": "npm@10.9.4"
}
