{
  "name": "open-design-tokens-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript toolkit for validating and linting DTCG design tokens.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bezel-labs/open-design-tokens.git"
  },
  "bugs": {
    "url": "https://github.com/bezel-labs/open-design-tokens/issues"
  },
  "homepage": "https://github.com/bezel-labs/open-design-tokens#readme",
  "keywords": [
    "dtcg",
    "design-tokens",
    "validator",
    "validation",
    "linter",
    "typescript",
    "w3c",
    "design-system"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "check": "biome check .",
    "format": "biome format --write .",
    "ci": "biome ci .",
    "spec-coverage": "node scripts/spec-coverage.mjs",
    "prepare": "husky",
    "size": "size-limit",
    "attw": "attw --pack packages/open-design-tokens --profile esm-only",
    "bench": "node scripts/bench.mjs",
    "tarball-test": "node scripts/tarball-test.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@size-limit/preset-small-lib": "14.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "size-limit": "14.3.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  },
  "packageManager": "npm@10.9.4",
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched"
  }
}
