{
  "c": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.2, 0.4, 0.9],
      "hex": "#3366e6"
    }
  },
  "red": {
    "$type": "number",
    "$value": {
      "$ref": "#/c/$value/components/0"
    }
  },
  "space": {
    "$type": "fontFamily",
    "$value": {
      "$ref": "#/c/$value/colorSpace"
    }
  },
  "meta": {
    "$type": "fontFamily",
    "$value": {
      "$ref": "#/c/$type"
    }
  }
}
