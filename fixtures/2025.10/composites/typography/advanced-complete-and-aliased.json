{
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": ["Inter", "sans-serif"]
    },
    "size": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "$value": "bold"
    }
  },
  "body": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{font.family}",
      "fontSize": "{font.size}",
      "fontWeight": "{font.weight}",
      "letterSpacing": {
        "value": 0,
        "unit": "px"
      },
      "lineHeight": 1.5
    }
  },
  "h1": {
    "$type": "typography",
    "$value": {
      "fontFamily": "Roboto",
      "fontSize": {
        "value": 42,
        "unit": "px"
      },
      "fontWeight": 700,
      "letterSpacing": {
        "value": 0.1,
        "unit": "px"
      },
      "lineHeight": 1.2
    }
  }
}
