{
  "s": {
    "$type": "shadow",
    "$value": {
      "color": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      },
      "offsetX": {
        "value": 0,
        "unit": "px"
      },
      "offsetY": {
        "value": 2,
        "unit": "px"
      },
      "blur": {
        "value": 4,
        "unit": "px"
      },
      "spread": {
        "value": 0,
        "unit": "px"
      }
    }
  },
  "b": {
    "$type": "border",
    "$value": "{s}"
  }
}
