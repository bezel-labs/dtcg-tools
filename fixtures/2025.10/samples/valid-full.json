            "components": [0.961, 0.62, 0.043],
            "hex": "#f59e0b"
          }
        }
      },
      "accent": {
        "$description": "Wide-gamut and cylindrical spaces for display tuning.",
        "violet": {
          "$value": {
            "colorSpace": "oklch",
            "components": [0.62, 0.21, 295]
          }
        },
        "teal": {
          "$value": {
